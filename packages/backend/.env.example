SERVER_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=codigo-a-voluntad

# Secreto con el que se firman los tokens de sesión y cuánto duran. En producción JWT_SECRET es obligatorio.
JWT_SECRET=cambiame-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA_EN=8h

# Notificaciones por medios externos. Sin estas variables el envío se simula por consola.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=avisos@example.com
# SMTP_PASS=
# EMAIL_FROM=avisos@example.com
# TELEGRAM_BOT_TOKEN=

# Cada cuánto se reintentan los envíos pendientes y cuántas veces antes de darlos por fallidos.
# NOTIFICACIONES_INTERVALO_MS=30000
# NOTIFICACIONES_MAXIMO_INTENTOS=5
