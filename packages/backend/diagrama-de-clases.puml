@startuml backend-diagrama-de-clases
skinparam classAttributeIconSize 0

enum UnidadCompromiso {
    HORAS_TOTALES
    HORAS_SEMANALES
    HORAS_MENSUALES
}

enum ModalidadColaboracion {
    GRATUITA
    CON_INCENTIVO_ECONOMICO
    CON_POSIBILIDAD_CONTRATACION
}

enum TipoCuenta {
    GITHUB
    GITLAB
}

enum EstadoProyecto {
    PUBLICADO
    CERRADO
}
enum TipoMedioContacto{
    EMAIL
    WHATSAPP
    SMS
}
class Colectivo {
    nombre: String
    descripcion: String
    tipo: TipoColectivo
    pais: Pais
    provincia: Provincia
    ciudad: String
    proyectos: Proyecto[]
}

class Proyecto {
    titulo: String
    descripcion: String
    estado: EstadoProyecto
    fechaAlta: Date
    fechaCierre: Date
    colectivo: Colectivo
    perfiles: Perfil[]
    colaboraciones: Colaboracion[]

    cerrar():void
    agregarPerfil(perfil: Perfil): Perfil
    buscarPerfil(perfilId: String): Perfil
    actualizarPerfil(perfil: Perfil, datos): void
    eliminarPerfil(perfilId: String): void
    agregarColaboracion(colaboracion: Colaboracion): void
    poseeHabilidadNecesaria(personaColaboradora: PersonaColaboradora): boolean
    proyectoCerrado(): boolean

}
class Perfil {
    nombre: String
    descripcion: String
    unidadCompromiso: UnidadCompromiso
    cantidadHoras: int
    modalidadesColaboracion: ModalidadColaboracion[]
    habilidadesRequeridas: Habilidad[]
    habilidadesOpcionales: Habilidad[]

    actualizar(datos): void
}

class MedioDeContacto{
    tipo: TipoMedioContacto
    valor: String
}
class PersonaColaboradora {
    nombreFantasia: String
    nombre: String
    apellido: String
    pronombres: String[]
    presentacion: String
    cuentas: Cuenta[]
    habilidades: Habilidad[]
    colaboraciones: Colaboracion[]
    aceptaMensajeriaInterna: Boolean
    mediosDeContacto: MedioDeContacto[]
}

class Colaboracion {
    fechainscripcion: Date
    esAnonima :  boolean
    personaColaboradora: PersonaColaboradora
    proyecto: Proyecto
}

class Habilidad {
    titulo: String
    codigo: String
    descripcion: String
}

class Cuenta {
    nombreUsuario: String
    tipo: TipoCuenta
}

class TipoColectivo {
    nombre: String
}

class Pais {
    id: int
    nombre: String
}

class Provincia {  
    id: int
    nombre: String
}

Colectivo --> TipoColectivo
Colectivo --> Pais
Colectivo --> Provincia
Colectivo --> Proyecto 
Proyecto --> Colectivo 
Proyecto *-- Perfil
Perfil --> Habilidad
Proyecto --> Colaboracion 
Colaboracion --> PersonaColaboradora 
Colaboracion --> Proyecto 
PersonaColaboradora --> Cuenta 
PersonaColaboradora --> Habilidad
PersonaColaboradora --> Colaboracion 
PersonaColaboradora --> MedioDeContacto
MedioDeContacto --> TipoMedioContacto
Perfil --> UnidadCompromiso
Perfil --> ModalidadColaboracion
Proyecto --> EstadoProyecto 
Cuenta --> TipoCuenta

@enduml