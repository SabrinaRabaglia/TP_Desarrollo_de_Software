@startuml backend-diagrama-de-clases
skinparam classAttributeIconSize 0

enum UnidadCompromiso {
    HORAS_TOTALES
    HORAS_SEMANALES
    HORAS_MENSUALES
}

enum ModalidadColaboracion {
    GRATUITA
    CON_INCENTIVO_ECONOMICO
    CON_POSIBILIDAD_CONTRATACION
}

enum TipoCuenta {
    GITHUB
    GITLAB
}

enum EstadoProyecto {
    PUBLICADO
    CERRADO
}
enum TipoMedioContacto{
    EMAIL
    WHATSAPP
    SMS
    TELEGRAM
}

enum EstadoPostulacion {
    PENDIENTE
    ACEPTADA
    RECHAZADA
    BAJA
}

enum OrigenBaja {
    COLECTIVO
    PERSONA_COLABORADORA
}

enum NivelCoincidencia {
    TOTAL
    PARCIAL
}

enum RolUsuario {
    COLECTIVO
    PERSONA_COLABORADORA
}

class Usuario {
    email: String
    hashContrasena: String
    rol: RolUsuario
    entidad: Colectivo o PersonaColaboradora
}

class Colectivo {
    nombre: String
    descripcion: String
    tipo: TipoColectivo
    pais: Pais
    provincia: Provincia
    ciudad: String
    proyectos: Proyecto[]
    notificacionesEnviadas: Notificacion[]
}

class Proyecto {
    titulo: String
    descripcion: String
    estado: EstadoProyecto
    fechaAlta: Date
    fechaCierre: Date
    enlaceSistemaEnFuncionamiento: String
    enlaceCodigoFuente: String
    colectivo: Colectivo
    perfiles: Perfil[]
    hitos: Hito[]

    cerrar():void
    proyectoCerrado(): boolean
    esDelColectivo(colectivoId: String): boolean
    buscarPerfil(perfilId: String): Perfil
    getPorcentajeConcrecionActual(): int
    assertPuedeBuscarColaboradores(): void
    assertPuedeModificarPerfiles(): void
    assertAdmiteHito(hito: Hito): void
    contactar(perfil: Perfil, personaColaboradora: PersonaColaboradora, contenido: String): Notificacion
    poseeHabilidadNecesaria(personaColaboradora: PersonaColaboradora): boolean
}

class Hito {
    fecha: Date
    porcentajeConcrecion: int
    descripcion: String
    proyecto: Proyecto
}
class Perfil {
    nombre: String
    descripcion: String
    unidadCompromiso: UnidadCompromiso
    cantidadHoras: int
    modalidadesColaboracion: ModalidadColaboracion[]
    habilidadesRequeridas: Habilidad[]
    habilidadesOpcionales: Habilidad[]
    limiteColaboraciones: int
    busquedaAbierta: boolean
    busquedaAbiertaHasta: Date
    postulacionesAceptadas: Postulacion[]

    coincidenciaCon(habilidades: Habilidad[]): Object
    cuposDisponibles(): int
    admiteModalidad(modalidad: ModalidadColaboracion): boolean
    tieneBusquedaAbierta(ahora: Date): boolean
    assertBusquedaAbierta(ahora: Date): void
    assertPuedeAceptarPostulaciones(): void
    agregarPostulacion(postulacion: Postulacion): void
    quitarPostulacion(postulacion: Postulacion): void
    reemplazarDatos(datos, ahora: Date): Perfil
}

class MedioDeContacto{
    tipo: TipoMedioContacto
    valor: String
}
class PersonaColaboradora {
    nombreFantasia: String
    nombre: String
    apellido: String
    pronombres: String[]
    presentacion: String
    cuentas: Cuenta[]
    habilidades: Habilidad[]
    aceptaMensajeriaInterna: Boolean
    mediosDeContacto: MedioDeContacto[]
    notificacionesRecibidas: Notificacion[]

    assertAceptaMensajeriaInterna(): void
    conectarTelegram(chatId: String): void
}

enum EstadoEnvio {
    PENDIENTE
    ENVIADO
    FALLIDO
}

class Envio {
    medio: MedioDeContacto
    estado: EstadoEnvio
    intentos: int
    ultimoError: String
    enviadoEn: Date
}

class Notificacion {
    fecha: Date
    contenido: String
    colectivo: Colectivo
    personaColaboradora: PersonaColaboradora
    perfil: Perfil
    envios: Envio[]
    procesandoDesde: Date
    reintentarDesde: Date

    pendienteDeEnvio(): boolean
    mediosExternosUtilizados(): TipoMedioContacto[]
    enviosPendientes(): Envio[]
    registrarEnvioExitoso(envio: Envio, fecha: Date): void
    registrarEnvioFallido(envio: Envio, error: String, maximoDeIntentos: int): void
    liberar(reintentarDesde: Date): void
}

class Postulacion {
    fechaPostulacion: Date
    fechaRevision: Date
    estado: EstadoPostulacion
    esAnonima: boolean
    fechaBaja: Date
    origenBaja: OrigenBaja
    personaColaboradora: PersonaColaboradora
    perfil: Perfil

    esDe(personaId: String): boolean
    assertPendiente(accion: String): void
    aceptar(): void
    rechazar(): void
    darDeBaja(origen: OrigenBaja): void
}

class Habilidad {
    titulo: String
    codigo: String
    descripcion: String
}

class Cuenta {
    nombreUsuario: String
    tipo: TipoCuenta
}

class TipoColectivo {
    nombre: String
}

class Pais {
    id: int
    nombre: String
}

class Provincia {  
    id: int
    nombre: String
}

Colectivo --> TipoColectivo
Colectivo --> Pais
Colectivo --> Provincia
Colectivo --> Proyecto 
Proyecto --> Colectivo 
Proyecto *-- Perfil
Proyecto *-- Hito
Perfil --> Habilidad
Perfil --> Postulacion
Perfil ..> NivelCoincidencia
Postulacion --> Perfil
Postulacion --> PersonaColaboradora
Postulacion --> EstadoPostulacion
Postulacion --> OrigenBaja
Usuario --> RolUsuario
Usuario --> Colectivo
Usuario --> PersonaColaboradora
PersonaColaboradora --> Cuenta 
PersonaColaboradora --> Habilidad
PersonaColaboradora --> MedioDeContacto
MedioDeContacto --> TipoMedioContacto
Colectivo --> Notificacion
PersonaColaboradora --> Notificacion
Notificacion --> Colectivo
Notificacion --> PersonaColaboradora
Notificacion --> Perfil
Notificacion *-- Envio
Envio --> MedioDeContacto
Envio --> EstadoEnvio
Perfil --> UnidadCompromiso
Perfil --> ModalidadColaboracion
Proyecto --> EstadoProyecto 
Cuenta --> TipoCuenta

@enduml