            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Comprueba que la API responde con `{ status: \"ok\" }`."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"responde 200\", () => pm.response.to.have.status(200))",
                  "pm.test(\"status es ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"))"
